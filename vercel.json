{
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/skaleedemo", "destination": "/skalito-demo.html" },
    { "source": "/demo", "destination": "/skalito-demo.html" },
    { "source": "/skalito", "destination": "/skalito-demo.html" },
    { "source": "/skalito-svg", "destination": "/skalito-svg.html" }
  ]
}
